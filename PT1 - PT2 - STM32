/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* USER CODE BEGIN 1 */
  /* USER CODE END 1 */

  HAL_Init();

  /* USER CODE BEGIN Init */
  /* USER CODE END Init */

  SystemClock_Config();

  /* USER CODE BEGIN SysInit */
  /* USER CODE END SysInit */

  MX_GPIO_Init();
  MX_USART2_UART_Init();
  MX_SPI1_Init();

  /* USER CODE BEGIN 2 */

  //******************************************/
  // ESP32 DESELECCIONADO AL INICIO
  //******************************************/

  HAL_GPIO_WritePin(
      ESP32_GPIO_Port,
      ESP32_Pin,
      GPIO_PIN_SET
  );

  //******************************************/
  // MOSTRAR MENU
  //******************************************/

  MostrarMenu();

  //******************************************/
  // EMPEZAR RECEPCION UART
  //******************************************/

  HAL_UART_Receive_IT(
      &huart2,
      datoRx,
      1
  );

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */

  while (1)
  {
      //******************************************/
      // PARTE 1 - PROCESAR MENU PRINCIPAL
      //******************************************/

      if (nuevaOpcion == 1)
      {
          nuevaOpcion = 0;

          //******************************************/
          // OPCION 1 - SPI
          //******************************************/

          if (opcionRecibida == '1')
          {
              modoSPI = 1;

              indiceComando = 0;

              memset(
                  comandoSPI,
                  0,
                  sizeof(comandoSPI)
              );

              MostrarSubmenuSPI();
          }

          //******************************************/
          // OPCION 2 - TODAVIA NO HACEMOS I2C
          //******************************************/

          else if (opcionRecibida == '2')
          {
              char mensaje[] =
              "\r\nOpcion 2 seleccionada: Sensor I2C\r\n"
              "Esta parte se agregara despues.\r\n";

              HAL_UART_Transmit(
                  &huart2,
                  (uint8_t*)mensaje,
                  strlen(mensaje),
                  HAL_MAX_DELAY
              );

              MostrarMenu();
          }

          //******************************************/
          // OPCION INVALIDA
          //******************************************/

          else
          {
              char mensaje[] =
              "\r\nOpcion no valida.\r\n";

              HAL_UART_Transmit(
                  &huart2,
                  (uint8_t*)mensaje,
                  strlen(mensaje),
                  HAL_MAX_DELAY
              );

              MostrarMenu();
          }
      }

      //******************************************/
      // PARTE 2 - PROCESAR COMANDO SPI
      //******************************************/

      if (comandoListo == 1)
      {
          comandoListo = 0;

          unsigned int led = 0;

          unsigned long tiempo = 0;

          //******************************************/
          // LEER COMANDO LED,TIEMPO
          // Ejemplo: 1,500
          //******************************************/

          if (
              sscanf(
                  comandoSPI,
                  "%u,%lu",
                  &led,
                  &tiempo
              ) == 2
          )
          {
              //******************************************/
              // VALIDAR DATOS
              //******************************************/

              if (
                  (led >= 1) &&
                  (led <= 3) &&
                  (tiempo > 0)
              )
              {
                  char mensaje[100];

                  sprintf(
                      mensaje,
                      "\r\nComando valido.\r\n"
                      "LED: %u\r\n"
                      "Tiempo: %lu ms\r\n"
                      "Enviando al ESP32...\r\n",
                      led,
                      tiempo
                  );

                  HAL_UART_Transmit(
                      &huart2,
                      (uint8_t*)mensaje,
                      strlen(mensaje),
                      HAL_MAX_DELAY
                  );

                  //******************************************/
                  // ENVIAR AL ESP32
                  //******************************************/

                  EnviarSPI(
                      (uint8_t)led,
                      (uint32_t)tiempo
                  );

                  //******************************************/
                  // GUARDAR TIEMPO PARA SABER
                  // CUANDO TERMINO EL LED
                  //******************************************/

                  inicioSPI =
                      HAL_GetTick();

                  tiempoSPI =
                      (uint32_t)tiempo;

                  esperandoFinSPI = 1;

                  modoSPI = 2;
              }

              else
              {
                  char error[] =
                  "\r\nDatos invalidos.\r\n"
                  "LED debe ser 1, 2 o 3.\r\n"
                  "Ejemplo: 1,500\r\n";

                  HAL_UART_Transmit(
                      &huart2,
                      (uint8_t*)error,
                      strlen(error),
                      HAL_MAX_DELAY
                  );

                  MostrarSubmenuSPI();
              }
          }

          else
          {
              char error[] =
              "\r\nFormato incorrecto.\r\n"
              "Use: LED,tiempo\r\n"
              "Ejemplo: 1,500\r\n";

              HAL_UART_Transmit(
                  &huart2,
                  (uint8_t*)error,
                  strlen(error),
                  HAL_MAX_DELAY
              );

              MostrarSubmenuSPI();
          }

          indiceComando = 0;

          memset(
              comandoSPI,
              0,
              sizeof(comandoSPI)
          );
      }

      //******************************************/
      // ESPERAR QUE TERMINE EL LED
      // OJO - SIN USAR DELAY
      //******************************************/

      if (esperandoFinSPI == 1)
      {
          if (
              HAL_GetTick() - inicioSPI
              >= tiempoSPI
          )
          {
              esperandoFinSPI = 0;

              modoSPI = 0;

              char mensaje[] =
              "\r\nOperacion SPI finalizada.\r\n";

              HAL_UART_Transmit(
                  &huart2,
                  (uint8_t*)mensaje,
                  strlen(mensaje),
                  HAL_MAX_DELAY
              );

              //******************************************/
              // REGRESAR AL MENU PRINCIPAL
              //******************************************/

              MostrarMenu();
          }
      }

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }

  /* USER CODE END 3 */
}

