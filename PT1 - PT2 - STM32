//******************************************/
// INTERRUPCION UART
//******************************************/

void HAL_UART_RxCpltCallback(
    UART_HandleTypeDef *huart)
{
    if (
        huart->Instance
        == USART2
    )
    {
        char dato =
            (char)datoRx[0];

        //******************************************/
        // MENU PRINCIPAL
        //******************************************/

        if (modoSPI == 0)
        {
            if (
                (dato == '1') ||
                (dato == '2')
            )
            {
                opcionRecibida =
                    dato;

                nuevaOpcion =
                    1;
            }
        }

        //******************************************/
        // SUBMENU SPI
        //******************************************/

        else if (modoSPI == 1)
        {
            //******************************************/
            // ENTER = TERMINAR COMANDO
            //******************************************/

            if (
                (dato == '\r') ||
                (dato == '\n')
            )
            {
                if (
                    (indiceComando > 0) &&
                    (comandoListo == 0)
                )
                {
                    comandoSPI[
                        indiceComando
                    ] = '\0';

                    comandoListo = 1;

                    indiceComando = 0;
                }
            }

            else
            {
                if (
                    comandoListo == 0
                )
                {
                    if (
                        indiceComando <
                        sizeof(comandoSPI) - 1
                    )
                    {
                        comandoSPI[
                            indiceComando
                        ] = dato;

                        indiceComando++;
                    }
                }
            }
        }

        //******************************************/
        // RECIBIR SIGUIENTE CARACTER
        //******************************************/

        HAL_UART_Receive_IT(
            &huart2,
            datoRx,
            1
        );
    }
}

