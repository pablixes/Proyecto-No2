//******************************************/
// ENVIAR DATOS AL ESP32 POR SPI
//******************************************/

void EnviarSPI(
    uint8_t led,
    uint32_t tiempo)
{
    /*
     * Byte 0 = numero de LED
     *
     * Byte 1-4 = tiempo en milisegundos
     */

    TxData[0] = led;

    TxData[1] =
        (uint8_t)(
            tiempo & 0xFF
        );

    TxData[2] =
        (uint8_t)(
            (tiempo >> 8)
            & 0xFF
        );

    TxData[3] =
        (uint8_t)(
            (tiempo >> 16)
            & 0xFF
        );

    TxData[4] =
        (uint8_t)(
            (tiempo >> 24)
            & 0xFF
        );

    //******************************************/
    // ACTIVAR ESP32
    // CS = LOW
    //******************************************/

    HAL_GPIO_WritePin(
        ESP32_GPIO_Port,
        ESP32_Pin,
        GPIO_PIN_RESET
    );

    //******************************************/
    // TRANSMITIR 5 BYTES
    //******************************************/

    HAL_SPI_TransmitReceive(
        &hspi1,
        TxData,
        RxData,
        5,
        HAL_MAX_DELAY
    );

    //******************************************/
    // DESACTIVAR ESP32
    // CS = HIGH
    //******************************************/

    HAL_GPIO_WritePin(
        ESP32_GPIO_Port,
        ESP32_Pin,
        GPIO_PIN_SET
    );
}

