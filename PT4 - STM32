/**
  * @brief Main
  */
int main(void)
{
    HAL_Init();

    SystemClock_Config();

    //******************************************/
    // INICIALIZAR PERIFERICOS
    //******************************************/

    MX_GPIO_Init();

    MX_USART2_UART_Init();

    MX_SPI1_Init();

    MX_I2C1_Init();

    /* USER CODE BEGIN 2 */

    //******************************************/
    // ESP32 DESELECCIONADO SPI
    //******************************************/

    HAL_GPIO_WritePin(
        ESP32_GPIO_Port,
        ESP32_Pin,
        GPIO_PIN_SET
    );

    //******************************************/
    // MOSTRAR MENU
    //******************************************/

    MostrarMenu();

    //******************************************/
    // ACTIVAR UART
    //******************************************/

    HAL_UART_Receive_IT(
        &huart2,
        datoRx,
        1
    );

    /* USER CODE END 2 */


    /* USER CODE BEGIN WHILE */

    while (1)
    {
        //******************************************/
        // PARTE 1
        // MENU PRINCIPAL
        //******************************************/

        if (
            nuevaOpcion == 1
        )
        {
            nuevaOpcion =
                0;

            //******************************************/
            // OPCION 1 - SPI
            //******************************************/

            if (
                opcionRecibida == '1'
            )
            {
                modoSPI =
                    1;

                indiceComando =
                    0;

                comandoListo =
                    0;

                memset(
                    comandoSPI,
                    0,
                    sizeof(comandoSPI)
                );

                MostrarSubmenuSPI();
            }

            //******************************************/
            // OPCION 2 - I2C
            //******************************************/

            else if (
                opcionRecibida == '2'
            )
            {
                char mensaje[] =
                "\r\nSolicitando medicion al ESP32...\r\n";

                HAL_UART_Transmit(
                    &huart2,
                    (uint8_t*)mensaje,
                    strlen(mensaje),
                    HAL_MAX_DELAY
                );

                ObtenerMedicionI2C();
            }
        }

        //******************************************/
        // PARTE 2
        // PROCESAR LED Y TIEMPO
        //******************************************/

        if (
            comandoListo == 1
        )
        {
            comandoListo =
                0;

            unsigned int led =
                0;

            unsigned long tiempo =
                0;

            int resultado =
                sscanf(
                    comandoSPI,
                    "%u , %lu",
                    &led,
                    &tiempo
                );

            //******************************************/
            // COMANDO VALIDO
            //******************************************/

            if (
                (resultado == 2) &&
                (led >= 1) &&
                (led <= 3) &&
                (tiempo > 0)
            )
            {
                char mensaje[100];

                snprintf(
                    mensaje,
                    sizeof(mensaje),

                    "\r\nComando valido.\r\n"
                    "LED: %u\r\n"
                    "Tiempo: %lu ms\r\n"
                    "Enviando al ESP32...\r\n",

                    led,
                    tiempo
                );

                HAL_UART_Transmit(
                    &huart2,
                    (uint8_t*)mensaje,
                    strlen(mensaje),
                    HAL_MAX_DELAY
                );

                EnviarSPI(
                    (uint8_t)led,
                    (uint32_t)tiempo
                );

                inicioSPI =
                    HAL_GetTick();

                tiempoSPI =
                    (uint32_t)tiempo;

                esperandoFinSPI =
                    1;

                modoSPI =
                    2;
            }

            //******************************************/
            // ERROR
            //******************************************/

            else
            {
                char error[] =
                "\r\nFormato incorrecto.\r\n"
                "Use LED,tiempo\r\n"
                "Ejemplo: 1,500\r\n"
                "Comando: ";

                HAL_UART_Transmit(
                    &huart2,
                    (uint8_t*)error,
                    strlen(error),
                    HAL_MAX_DELAY
                );

                modoSPI =
                    1;
            }

            indiceComando =
                0;

            memset(
                comandoSPI,
                0,
                sizeof(comandoSPI)
            );
        }

        //******************************************/
        // FIN DE OPERACION SPI
        //******************************************/

        if (
            esperandoFinSPI == 1
        )
        {
            if (
                HAL_GetTick() -
                inicioSPI >=
                tiempoSPI
            )
            {
                esperandoFinSPI =
                    0;

                modoSPI =
                    0;

                char mensaje[] =
                "\r\nOperacion SPI finalizada.\r\n";

                HAL_UART_Transmit(
                    &huart2,
                    (uint8_t*)mensaje,
                    strlen(mensaje),
                    HAL_MAX_DELAY
                );

                MostrarMenu();
            }
        }
    }

    /* USER CODE END WHILE */
}


