//******************************************/
// PARTE 2
// ENVIAR SPI
//******************************************/

void EnviarSPI(
    uint8_t led,
    uint32_t tiempo)
{
    TxData[0] =
        led;

    TxData[1] =
        (uint8_t)(
            tiempo & 0xFF
        );

    TxData[2] =
        (uint8_t)(
            (tiempo >> 8)
            & 0xFF
        );

    TxData[3] =
        (uint8_t)(
            (tiempo >> 16)
            & 0xFF
        );

    TxData[4] =
        (uint8_t)(
            (tiempo >> 24)
            & 0xFF
        );

    //******************************************/
    // CS LOW
    //******************************************/

    HAL_GPIO_WritePin(
        ESP32_GPIO_Port,
        ESP32_Pin,
        GPIO_PIN_RESET
    );

    //******************************************/
    // TRANSMITIR SPI
    //******************************************/

    HAL_SPI_TransmitReceive(
        &hspi1,
        TxData,
        RxData,
        5,
        HAL_MAX_DELAY
    );

    //******************************************/
    // CS HIGH
    //******************************************/

    HAL_GPIO_WritePin(
        ESP32_GPIO_Port,
        ESP32_Pin,
        GPIO_PIN_SET
    );
}

//******************************************/
// PARTE 3
// OBTENER MEDICION I2C
//******************************************/

void ObtenerMedicionI2C(void)
{
    HAL_StatusTypeDef estado;

    //******************************************/
    // PASO 1
    // PEDIR NUEVA MEDICION
    //******************************************/

    comandoI2C =
        'M';

    estado =
        HAL_I2C_Master_Transmit(
            &hi2c1,
            ESP32_I2C_ADDRESS,
            &comandoI2C,
            1,
            100
        );

    //******************************************/
    // ERROR DE TRANSMISION
    //******************************************/

    if (
        estado != HAL_OK
    )
    {
        char error[] =
        "\r\nError: no se pudo comunicar con el ESP32 por I2C.\r\n";

        HAL_UART_Transmit(
            &huart2,
            (uint8_t*)error,
            strlen(error),
            HAL_MAX_DELAY
        );

        MostrarMenu();

        return;
    }

    //******************************************/
    // ESPERAR QUE EL ESP32 HAGA ANALOGREAD
    //******************************************/

    HAL_Delay(
        50
    );

    //******************************************/
    // PASO 2
    // RECIBIR MEDICION
    //******************************************/

    estado =
        HAL_I2C_Master_Receive(
            &hi2c1,
            ESP32_I2C_ADDRESS,
            &datoI2C,
            1,
            100
        );

    //******************************************/
    // DATO RECIBIDO CORRECTAMENTE
    //******************************************/

    if (
        estado == HAL_OK
    )
    {
        /*
         * IMPORTANTE:
         *
         * datoI2C se usa DIRECTAMENTE.
         *
         * NO:
         *
         * 255 - datoI2C
         *
         * NO se invierte.
         */

        uint32_t milivoltios =
            (
                (uint32_t)datoI2C *
                3300
            ) /
            255;

        char mensaje[120];

        snprintf(
            mensaje,
            sizeof(mensaje),

            "\r\n===== MEDICION I2C =====\r\n"
            "ADC: %u / 255\r\n"
            "Voltaje aproximado: %lu.%03lu V\r\n",

            datoI2C,

            milivoltios / 1000,

            milivoltios % 1000
        );

        HAL_UART_Transmit(
            &huart2,
            (uint8_t*)mensaje,
            strlen(mensaje),
            HAL_MAX_DELAY
        );
    }

    //******************************************/
    // ERROR DE RECEPCION
    //******************************************/

    else
    {
        char error[] =
        "\r\nError al recibir la medicion I2C.\r\n";

        HAL_UART_Transmit(
            &huart2,
            (uint8_t*)error,
            strlen(error),
            HAL_MAX_DELAY
        );
    }

    //******************************************/
    // REGRESAR AL MENU
    //******************************************/

    MostrarMenu();
}

