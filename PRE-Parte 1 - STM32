/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */
  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */
  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */
  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART2_UART_Init();
  MX_SPI1_Init();
  MX_I2C1_Init();
  /* USER CODE BEGIN 2 */

  MostrarMenu();

  HAL_UART_Receive_IT(
      &huart2,
      datoRx,
      1
  );

  // Activamos slave
  HAL_GPIO_WritePin(ESP32_GPIO_Port, ESP32_Pin , GRxDSta, 1, GPIO_PIN_SET);
  HAL_SPI_TransmitReceive(&hspi1, &TxData, &RxData, 1, HAL_MAX_DELAY);
  // Desactivamos slave
  HAL_GPIO_WritePin (ESP32_GPIO_Port, ESP32_Pin, GPIO_PIN_SET);

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */

  // agregado por el ejemplo de pablo
  while (1) {

	  [TX_Buffer [0] = 'S';
	  HAL_I2C_Master_Transmit (&hi2c1, WriteSlaveAddress, TX_Buffer, 1, HAL_MAX_DELAY);
	  HAL_Delay(1000) ;
	  TX_Buffer [0] = '0';
	  HAL_I2C_Master_Transmit (&hi2c1, WriteSlaveAddress, TX_Buffer, 1, HAL_MAX_DELAY);
	  HAL_Delay(1000) ;

	  // Lectura
	  HAL_I2C_Master_Receive(&hi2c1, ReadSlaveAddress, (uint8_t*) RX_Buffer, 1, HAL_MAX_DELAY);_
	  HAL_UART_Transmit (&huart2, RX_Buffer, 1, 1000) ;
	  HAL_Delay(500)


  while(1)
  {
      if(nuevaOpcion==1)
      {
          nuevaOpcion=0;

          if(opcionRecibida=='1')
          {
              char mensaje[]=
              "\r\nOpcion 1 seleccionada: Controlar dispositivo SPI\r\n";

              HAL_UART_Transmit(
                  &huart2,
                  (uint8_t*)mensaje,
                  strlen(mensaje),
                  HAL_MAX_DELAY
              );

              MostrarMenu();
          }

          else if(opcionRecibida=='2')
          {
              char mensaje[]=
              "\r\nOpcion 2 seleccionada: Obtener medicion de sensor I2C\r\n";

              HAL_UART_Transmit(
                  &huart2,
                  (uint8_t*)mensaje,
                  strlen(mensaje),
                  HAL_MAX_DELAY
              );

              MostrarMenu();
          }

          else if((opcionRecibida!='\r')&&(opcionRecibida!='\n'))
          {
              char mensaje[]=
              "\r\nOpcion no valida. Ingrese 1 o 2.\r\n";

              HAL_UART_Transmit(
                  &huart2,
                  (uint8_t*)mensaje,
                  strlen(mensaje),
                  HAL_MAX_DELAY
              );

              MostrarMenu();
          }
      }
      TxData = 1;
      // Activamos slave
        HAL_GPIO_WritePin(ESP32_GPIO_Port, ESP32_Pin , GRxDSta, 1, GPIO_PIN_SET);
        HAL_SPI_TransmitReceive(&hspi1, &TxData, &RxData, 1, HAL_MAX_DELAY);
        // Desactivamos slave
        HAL_GPIO_WritePin (ESP32_GPIO_Port, ESP32_Pin, GPIO_PIN_SET);
        Hal_Delay(500);

        TxData = 0;
              // Activamos slave
                HAL_GPIO_WritePin(ESP32_GPIO_Port, ESP32_Pin , GRxDSta, 1, GPIO_PIN_SET);
                HAL_SPI_TransmitReceive(&hspi1, &TxData, &RxData, 1, HAL_MAX_DELAY);
                // Desactivamos slave
                HAL_GPIO_WritePin (ESP32_GPIO_Port, ESP32_Pin, GPIO_PIN_SET);
                Hal_Delay(500);

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }

  /* USER CODE END 3 */
}

